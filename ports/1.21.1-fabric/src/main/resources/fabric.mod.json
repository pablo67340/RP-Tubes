{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "RedPower2 pneumatic tubes and related machines revived for Fabric.",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.rptubes.RPTubes"
    ],
    "client": [
      "com.rptubes.client.RPTubesClient"
    ],
    "jei_mod_plugin": [
      "com.rptubes.compat.jei.RPTubesJeiPlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "jei": "*"
  }
}
